{
  "name": "computer-bridge-updater",
  "main": "src/update_worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"CF_ACCOUNT_ID": "REPLACE_ACCOUNT_ID", "CF_WORKER_NAME": "computer-bridge", "TARGET_URL": "https://bridge.example.com"},
  "services": [{"binding": "TARGET", "service": "computer-bridge", "entrypoint": "Maintenance"}],
  "durable_objects": {"bindings": [{"name": "JOBS", "class_name": "ReleaseUpdate"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReleaseUpdate"]}]
}
